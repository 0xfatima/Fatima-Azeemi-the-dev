+          await page.render({ canvasContext: canvas.getContext("2d"), viewport }).promise;
+        }
+        if (!cancelled) setStatus("ready");
+      } catch {
+        if (!cancelled) setStatus("error");
+      }
+    };
+
+    render();
+    return () => {
+      cancelled = true;
+      pdf?.destroy();
+    };
+  }, [open, src, title]);
