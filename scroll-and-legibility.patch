+  scroll-margin-top: 7rem;
+}
+
+section[id]:not(#hero) {
+  scroll-margin-top: 5.5rem;
+}
+
+/* Progressive blur scrim: stacked backdrop blurs, each masked a little tighter,
+   so the pixel detail behind the words melts smoothly (no visible box edge)
+   while the blue/red colour still shows through. Fades in with the blend. */
+.hero-scrim {
+  --scrim-tint: 251, 249, 245;
   position: absolute;
   inset: 0;
-  z-index: 0;
+  z-index: 1;
   pointer-events: none;
